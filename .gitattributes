# Generated files. GitHub collapses them in PR diffs.
# Workflow YAML: `mise run generate-workflows` (edit the .pkl sources).
# PklProject.deps.json: `pkl project resolve .github/`. mise.lock: `mise lock`.
.github/workflows/*.yml linguist-generated=true
.github/PklProject.deps.json linguist-generated=true
mise.lock linguist-generated=true
